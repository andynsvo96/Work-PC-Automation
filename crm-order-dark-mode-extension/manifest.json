{
  "manifest_version": 3,
  "name": "CRM Order Assistant",
  "version": "1.8.9",
  "minimum_chrome_version": "111",
  "description": "CRM order tools, native All Orders and All Tabs editors, Salesforce tab reuse, and Orders email sender selection.",
  "permissions": ["storage", "tabs", "webNavigation", "scripting"],
  "host_permissions": [
    "https://crm2.legacy.printfly.com/*",
    "*://*.salesforce.com/*",
    "*://*.force.com/*",
    "*://*.visualforce.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CRM Order Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["order-all-batch.js", "order-all.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["order-edit-previews.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["all-tabs-model.js", "all-tabs.js"],
      "css": ["all-tabs.css"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["all-orders-page.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["order-scan-reader.js", "order-scan-bridge.js", "emb-design-reader.js", "emb-design-bridge.js", "copyright-design-reader.js", "copyright-design-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["order-sections.js", "content.js"],
      "css": ["dark-mode.css", "order-qol.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["rush-list-highlight.js"],
      "css": ["rush-list-highlight.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"],
      "js": ["salesforce-email-sender.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
