{
  "manifest_version": 3,
  "name": "CRM Order Assistant",
  "version": "1.7.19",
  "description": "CRM order tools, Salesforce tab reuse, and automatic Orders email sender selection.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": [
    "https://crm2.legacy.printfly.com/*",
    "*://*.salesforce.com/*",
    "*://*.force.com/*",
    "*://*.visualforce.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "CRM Order Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["emb-design-reader.js", "emb-design-bridge.js", "copyright-design-reader.js", "copyright-design-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["content.js"],
      "css": ["dark-mode.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://crm2.legacy.printfly.com/*"],
      "js": ["rush-list-highlight.js"],
      "css": ["rush-list-highlight.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://*.salesforce.com/*", "https://*.force.com/*"],
      "js": ["salesforce-email-sender.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
